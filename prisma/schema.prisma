generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  PROFESSOR
  COORDENADOR
}

enum StatusProva {
  PENDENTE
  CONCLUIDA
  CANCELADA
}

enum Bimestre {
  PRIMEIRO
  SEGUNDO
  TERCEIRO
  QUARTO
}

model Escola {
  id   String @id @default(uuid()) @db.Uuid
  nome String @unique @db.VarChar(255)

  users  User[]
  turmas Turma[]

  @@map("escolas")
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(255)
  email           String   @unique
  cpf             String   @unique @db.VarChar(11)
  data_nascimento DateTime @db.Date
  sexo            String   @db.VarChar(20)

  password String   @db.VarChar(255)
  role     UserRole @default(PROFESSOR)

  mustChangePassword          Boolean   @default(false) @map("must_change_password")
  temporaryPasswordExpiresAt  DateTime? @map("temporary_password_expires_at") @db.Timestamptz(3)
  tokenVersion                Int       @default(0) @map("token_version")
  passwordChangedAt           DateTime? @map("password_changed_at") @db.Timestamptz(3)

  escolaId String @db.Uuid
  escola   Escola @relation(fields: [escolaId], references: [id])

  turmas              Turma[]
  provas               Prova[]
  passwordResetTokens  PasswordResetToken[]

  create_at  DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Prova {
  id        String      @id @default(uuid()) @db.Uuid
  titulo    String      @db.VarChar(255)
  descricao String      @db.VarChar(500)
  status    StatusProva @default(PENDENTE)
  bimestre  Bimestre
  anoLetivo String      @db.VarChar(9)

  motivo_cancelamento String? @db.VarChar(500)
  arquivo_url         String  @db.VarChar(500)

  professorId String @db.Uuid
  professor   User   @relation(fields: [professorId], references: [id])

  turmaId String @db.Uuid
  turma   Turma  @relation(fields: [turmaId], references: [id])

  create_at  DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  @@map("provas")
}

model Turma {
  id   String @id @default(uuid()) @db.Uuid
  nome String @unique @db.VarChar(255)

  escolaId String @db.Uuid
  escola   Escola @relation(fields: [escolaId], references: [id])

  professores User[]
  provas      Prova[]

  create_at  DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  @@map("turmas")
}
